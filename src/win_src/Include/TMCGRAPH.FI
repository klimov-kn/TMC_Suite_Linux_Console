*
* int  _far _Cdecl get_norm_transf( int nt_num, struct viewporttype far *vp,
*                                      struct float_window far *fvp,
*                                      struct float_window far *fwn);
*
      INTERFACE TO FUNCTION get_norm_transf
     +       [FAR,C,ALIAS:"_get_norm_transf"](nt_num, vp, fvp, fwn)
        INTEGER*2 get_norm_transf, nt_num
        STRUCTURE/ viewporttype /
          integer*2 left, top, right, bottom
          integer*2 clip
        END STRUCTURE
        STRUCTURE/ float_window/
           real*4 left, bottom, right, top
        END STRUCTURE
        record/float_window/fvp[FAR,REFERENCE] ,fwn[FAR,REFERENCE]
        record/viewporttype/vp[FAR,REFERENCE]

      END


